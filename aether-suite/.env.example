# Runtime mode: development | production | test
NODE_ENV=development

# MongoDB connection URI for all products
MONGODB_URI=mongodb://localhost:27017/aether_suite

# NextAuth configuration
NEXTAUTH_SECRET=replace_with_a_long_random_secret
NEXTAUTH_URL=http://localhost:3000

# Google OAuth credentials
GOOGLE_CLIENT_ID=google_client_id_here
GOOGLE_CLIENT_SECRET=google_client_secret_here

# Stripe server-side credentials
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me


# Stripe product price IDs
STRIPE_PRO_PRICE_ID=price_pro_monthly_replace_me
STRIPE_PRICE_RFP_TOOL_PACK_5=price_rfp_pack_5_replace_me
STRIPE_PRICE_RFP_TOOL_PACK_15=price_rfp_pack_15_replace_me
STRIPE_PRICE_COMPLIANCE_TOOL_PACK_10=price_compliance_pack_10_replace_me
STRIPE_PRICE_COMPLIANCE_TOOL_PACK_30=price_compliance_pack_30_replace_me
STRIPE_PRICE_MARKET_ANALYZER_PACK_5=price_market_pack_5_replace_me
STRIPE_PRICE_MARKET_ANALYZER_PACK_15=price_market_pack_15_replace_me
STRIPE_PRICE_PROPOSAL_OPTIMIZER_PACK_10=price_proposal_pack_10_replace_me
STRIPE_PRICE_PROPOSAL_OPTIMIZER_PACK_30=price_proposal_pack_30_replace_me
STRIPE_PRICE_LANDING_CRITIC_PACK_10=price_landing_pack_10_replace_me
STRIPE_PRICE_LANDING_CRITIC_PACK_30=price_landing_pack_30_replace_me

# Optional AI provider API keys (leave blank to disable a provider)
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=

# Public runtime values exposed to the browser
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
